#!/bin/bash
set -euxo pipefail

dnf install -y python3-boto3 || (dnf install -y python3-pip && pip3 install boto3)

mkdir -p /opt/worker
echo '${worker_b64}' | base64 -d > /opt/worker/worker.py

cat > /etc/systemd/system/worker.service <<'UNIT'
[Unit]
Description=SQS file worker
After=network-online.target
Wants=network-online.target

[Service]
Environment=AWS_REGION=${region}
Environment=QUEUE_URL=${queue_url}
Environment=LOG_GROUP=${log_group}
ExecStart=/usr/bin/python3 /opt/worker/worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now worker.service